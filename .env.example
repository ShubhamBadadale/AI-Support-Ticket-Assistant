# Local defaults — copy to .env or export. Never commit secrets.
DATABASE_URL=jdbc:h2:mem:tickets;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE;MODE=PostgreSQL
DATABASE_USER=sa
DATABASE_PASSWORD=
DATABASE_DRIVER=org.h2.Driver
AI_PROVIDER=stub
AI_MODEL=stub-1.0
# For Postgres/pgvector via docker-compose:
# DATABASE_URL=jdbc:postgresql://localhost:5432/tickets
# DATABASE_USER=tickets
# DATABASE_PASSWORD=tickets
# DATABASE_DRIVER=org.postgresql.Driver
# For real model (optional):
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
